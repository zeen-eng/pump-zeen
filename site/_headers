# ═══════════════════════════════════════════════════════════════
# ترويسات الأمان والتخزين المؤقت — يقرؤها tools/build-edge.mjs
# no-cache: المتصفح يتحقق من وجود نسخة أحدث في كل زيارة (ETag)، فيصل أي تحديث فوراً
# ═══════════════════════════════════════════════════════════════
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; style-src-attr 'unsafe-inline'; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://rmuwprafvgqwemohrcce.supabase.co; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Cache-Control: no-cache

/admin*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

/app*
  Cache-Control: no-store
